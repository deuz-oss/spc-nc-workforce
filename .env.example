# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# These are PUBLIC values baked into the client bundle by Expo (EXPO_PUBLIC_*),
# safe to expose - all real access control happens via Postgres Row Level
# Security, not by keeping these secret.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: show the seeded demo logins on the login screen outside dev builds
# (UAT against the demo project only — never against real data).
# EXPO_PUBLIC_SHOW_DEMO_ACCOUNTS=true

# Optional: map tile server for the in-app maps (LeafletMap). The default is
# OpenStreetMap's community server, which is not meant for production-scale use —
# use a keyed provider (e.g. MapTiler, Stadia, Thunderforest) for go-live, with
# its required attribution text.
# EXPO_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# EXPO_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors

# Used ONLY by scripts/seed-supabase.ts, run locally by a developer.
# NEVER prefix this with EXPO_PUBLIC_, never commit it, never put it in app code -
# it bypasses Row Level Security entirely.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
