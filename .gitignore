# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# editor workspace config (local, per-contributor)
*.code-workspace

# local env files
.env
.env*.local

# Supabase CLI local cache
supabase/.temp/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
dist/

# Firebase config for Android push — supplied via the GOOGLE_SERVICES_JSON EAS file secret, never committed (public repo)
google-services.json
# FCM V1 service-account key — upload with `eas credentials`, never commit
*-firebase-adminsdk-*.json
